<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The ONE list of what the Stride2D runtime is.
    Items with Feature="x" are translated only for a game that mentions that feature's namespace (terrain: Stride2D.Terrain), so unused code never
    holds a game back. The .NET build (the reference) compiles it; tools/player_build.py reads the same list and
    translates it, with the game's scripts, to a single C file. Items marked CBuild="false" are .NET-only (the native bindings, which the C
    build replaces with the generated C flavor). No NuGet packages: nothing here depends on anything.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stride2D</RootNamespace>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NuGetAudit>false</NuGetAudit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup Label="Physics core">
    <Compile Include="src\physics\MaxInstancesAttribute.cs" />
    <Compile Include="src\physics\Arena.cs" />
    <Compile Include="src\physics\Pose2D.cs" />
    <Compile Include="src\physics\Collider2DGeometry.cs" />
    <Compile Include="src\physics\HandleTable.cs" />
    <Compile Include="src\physics\TriggerSet.cs" />
    <Compile Include="src\physics\BodyRecord.cs" />
    <Compile Include="src\physics\JointRecord.cs" />
    <Compile Include="src\physics\Registry2D.cs" />
    <Compile Include="src\physics\SimCore2D.cs" />
  </ItemGroup>

  <ItemGroup Label="The runtime">
    <Compile Include="src\core\CoreLimits.cs" />
    <Compile Include="src\core\ScriptAttribute.cs" />
    <Compile Include="src\core\Node.cs" />
    <Compile Include="src\core\Component.cs" />
    <Compile Include="src\core\Rigidbody2D.cs" />
    <Compile Include="src\core\Collider2D.cs" />
    <Compile Include="src\core\World2D.cs" />
    <Compile Include="src\core\SpriteRenderer2D.cs" />
    <Compile Include="src\core\MeshRenderer2D.cs" />
    <Compile Include="src\core\Renderer2D.cs" />
    <Compile Include="src\core\Scene2D.cs" />
  </ItemGroup>

  <ItemGroup Label="Terrain model (ported from DTerrain)">
    <Compile Include="src\terrain\Calc.cs" Feature="terrain" />
    <Compile Include="src\terrain\Range.cs" Feature="terrain" />
    <Compile Include="src\terrain\Column.cs" Feature="terrain" />
    <Compile Include="src\terrain\Shape.cs" Feature="terrain" />
    <Compile Include="src\terrain\PixelRect.cs" Feature="terrain" />
    <Compile Include="src\terrain\ColumnQuadTree.cs" Feature="terrain" />
    <Compile Include="src\terrain\RectMerge.cs" Feature="terrain" />
    <Compile Include="src\terrain\ChainTrace.cs" Feature="terrain" />
    <Compile Include="src\terrain\TerrainLimits.cs" Feature="terrain" />
    <Compile Include="src\terrain\TerrainChunk.cs" Feature="terrain" />
    <Compile Include="src\terrain\SandSim.cs" Feature="terrain" />
    <Compile Include="src\terrain\TerrainLayer.cs" Feature="terrain" />
  </ItemGroup>

  <ItemGroup Label="Destruction (ported from Unity-2D-Destruction)">
    <Compile Include="src\destruction\PolySet.cs" Feature="destruction" />
    <Compile Include="src\destruction\Fracturer.cs" Feature="destruction" />
    <Compile Include="src\destruction\ExplodeOptions.cs" Feature="destruction" />
    <Compile Include="src\destruction\Destruction2D.cs" Feature="destruction" />
  </ItemGroup>

  <!-- The in-game UI draws with the renderer, whose C# bindings (GFX) are generated when a game is built (tools/gen_pb2.py --lib gfx2d), so a plain
       `dotnet build` of this project leaves it out; a game that uses it adds the generated GFX.net.cs and builds with -p:Stride2DGfx=true. -->
  <ItemGroup Label="In-game UI" Condition="'$(Stride2DGfx)' == 'true'">
    <Compile Include="src\ui\UIText.cs" Feature="ui" />
  </ItemGroup>

</Project>
